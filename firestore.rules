rules_version = '2';

// ============================================================================
// قواعد أمان Cloud Firestore لتطبيق "مصروف" (Masroof)
// ============================================================================
// عزل أمني صارم (Zero-Trust User Isolation):
// 1. يمنع الوصول لغير المسجلين (Default Deny).
// 2. كل مستخدم مسجل يملك حق الوصول الحصري فقط لمجلد بياناته ونسخه السحابية.
// 3. يستحيل على أي مستخدم قراءة أو كتابة أو حذف بيانات مستخدم آخر.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // إغلاق أي مسارات عامة أخرى
    match /{document=**} {
      allow read, write: if false;
    }

    // مسار بيانات وحساب ونسخ المستخدم
    match /users/{userId} {
      // السماح فقط لصاحب الحساب المسجل بقراءة وكتابة وتعديل وحذف بياناته
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // كافة المجموعات الفرعية (backups, chunks) معزولة تماماً للمالك فقط
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
